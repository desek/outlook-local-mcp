{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "http://localhost/index.html",
        "http://localhost/quickstart.html",
        "http://localhost/concepts.html",
        "http://localhost/troubleshooting.html",
        "http://localhost/about/index.html",
        "http://localhost/contact/index.html",
        "http://localhost/privacy/index.html"
      ],
      "numberOfRuns": 3,
      "settings": {
        "onlyCategories": [
          "performance",
          "accessibility",
          "best-practices",
          "seo"
        ]
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^https?://[^/]+/index\\.html$",
          "assertions": {
            "categories:accessibility": ["error", { "minScore": 1 }],
            "categories:best-practices": ["error", { "minScore": 1 }],
            "categories:seo": ["error", { "minScore": 1 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 2700 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.01 }]
          }
        },
        {
          "matchingUrlPattern": ".*/(quickstart|concepts|troubleshooting)\\.html$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 1 }],
            "categories:accessibility": ["error", { "minScore": 1 }],
            "categories:best-practices": ["error", { "minScore": 1 }],
            "categories:seo": ["error", { "minScore": 1 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 1700 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.01 }],
            "total-blocking-time": ["error", { "maxNumericValue": 50 }]
          }
        },
        {
          "matchingUrlPattern": ".*/(about|contact|privacy)/index\\.html$",
          "assertions": {
            "categories:performance": ["warn", { "minScore": 1 }],
            "categories:accessibility": ["warn", { "minScore": 1 }],
            "categories:best-practices": ["warn", { "minScore": 1 }],
            "categories:seo": ["warn", { "minScore": 1 }],
            "largest-contentful-paint": ["warn", { "maxNumericValue": 1700 }],
            "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.01 }],
            "total-blocking-time": ["warn", { "maxNumericValue": 50 }]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./.lighthouseci"
    }
  }
}
