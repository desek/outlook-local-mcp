# Node modules (commitlint)
node_modules/

# Docker volume data
# Anchored to the repo root: unanchored (`data/`) matches at any depth and would
# silently ignore `site/**/data/`, which is exactly how CR-0069 lost committed
# modules. Keep the leading slash (CR-0070 FR-5).
/data/

# Environment-specific MCP config (contains local paths)
.mcp.json

# GoReleaser build artifacts
dist/

# MCPB extension build artifacts
extension/bin/
*.mcpb
.local/

# Local test reports
TEST-REPORT*.md

# CRUD bench per-run artifacts (CSV is checked in)
docs/bench/runs/

# CR-0060 bench scratch space
/bin/
/.worktrees/
docs/research/cr-0060-token-economics/runs/
# Staged container binaries produced by scripts/stage-container-binaries.sh
/linux/

# Claude Code agent worktrees
/.claude/worktrees/

# Website build artifacts (CR-0070). The site source at /site/ is tracked; only
# its generated outputs and installed dependencies are ignored.
/site/node_modules/
/site/dist/
# TypeScript incremental build cache emitted by `tsc -b`.
/site/*.tsbuildinfo
