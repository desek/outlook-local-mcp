FROM debian:trixie-slim
ENV DEBIAN_FRONTEND=noninteractive \
    GLAMA_VERSION="1.0.0" \
    PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl git && curl -fsSL https://deb.nodesource.com/setup_26.x | bash - && apt-get install -y --no-install-recommends nodejs && npm install -g mcp-proxy@6.4.3 pnpm@10.14.0 && node --version && curl -LsSf https://astral.sh/uv/install.sh | UV_INSTALL_DIR="/usr/local/bin" sh && uv python install 3.14 --default --preview && ln -s $(uv python find) /usr/local/bin/python && python --version && apt-get clean && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*
WORKDIR /app
RUN git clone https://github.com/desek/outlook-local-mcp . && git checkout 326f3d74ad5d847860c537affcf97ebb842199e8
ENV PATH="/app/node_modules/.bin:$PATH"
RUN (apt-get update && apt-get install -y --no-install-recommends curl ca-certificates) && (curl -fsSL https://go.dev/dl/go1.25.12.linux-amd64.tar.gz -o /tmp/go.tgz && tar -C /usr/local -xzf /tmp/go.tgz && rm /tmp/go.tgz) && (CGO_ENABLED=0 /usr/local/go/bin/go build -trimpath -ldflags '-s -w' -o /usr/local/bin/outlook-local-mcp ./cmd/outlook-local-mcp)
CMD ["mcp-proxy","--","/usr/local/bin/outlook-local-mcp"]
